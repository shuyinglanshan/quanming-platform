# ============ 服务端口 ============
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ============ 首个管理员账号（仅在数据库为空时创建一次） ============
# 全部留空即可：首次启动会自动随机生成用户名与密码，并打印到控制台
# 若需固定账号，可填写下面的项（密码至少 8 位，含字母与数字）
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_NICKNAME=平台管理员

# ============ 会话安全 ============
# 闲置超时（小时）：超过该时长没有任何请求则自动踢出，需重新登录
# 默认 168（7 天）；设为 0 或负数会被修正为 1
SESSION_IDLE_HOURS=168
# 仅用于本地测试的秒级覆盖（生产请勿设置）
# SESSION_IDLE_SECONDS=2

# ============ 反向代理信任（安全关键） ============
# 默认不信任任何代理，客户端 IP 取 TCP 连接地址，无法通过 X-Forwarded-For 伪造绕过限流
# 若部署在 Nginx / Caddy / CDN 之后，必须设置：
#   TRUST_PROXY=1
#   TRUST_PROXY_HOPS=1              # 前面有几层代理
#   TRUSTED_PROXIES=127.0.0.1/32    # 可信任的反代 IP/CIDR，逗号分隔
# 未正确配置时所有访客会被识别为反代 IP，导致限流误伤全体用户
TRUST_PROXY=
TRUST_PROXY_HOPS=1
TRUSTED_PROXIES=

# ============ 应用层加密 & 密码安全 ============
# 密码 pepper：用于二次收敛客户端 SHA-256 摘要，必须设置为随机长字符串
# 生成方式： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=

# ============ 防中间人（MITM） ============
# 强制敏感操作走 HTTPS（部署到公网时建议开启）
FORCE_HTTPS=0
# 启用 HSTS（生产环境建议开启，且必须已配置有效证书）
ENABLE_HSTS=0

# ============ QQ 邮箱 SMTP ============
# 优先级：后台「邮箱配置」页面 > 本文件
# 发件邮箱仅支持 @qq.com；两者都未配置时无法发送邮箱验证码（可用手机号注册）
#
# QQ 邮箱需在「设置 → 账户 → POP3/IMAP/SMTP 服务」开启并生成「授权码」，不是登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM_NAME=小天才圈名平台
