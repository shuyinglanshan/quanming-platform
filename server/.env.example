# ============================================================
# 小天才圈名平台 · 环境变量示例
# 复制为 .env 后按需修改；生产环境务必设置强密码
# ============================================================

# ---------- 服务 ----------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ---------- 初始管理员（仅首次启动、数据库为空时生效）----------
# 密码留空则随机生成并在启动日志打印一次
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_NICKNAME=平台管理员

# ---------- 极验人机验证（GeeTest v4）----------
# 注册与登录使用**各自独立**的验证应用，需分别填写
# 也可在管理后台「人机验证」中配置（数据库优先于环境变量）
GEETEST_REGISTER_CAPTCHA_ID=
GEETEST_REGISTER_CAPTCHA_KEY=
GEETEST_LOGIN_CAPTCHA_ID=
GEETEST_LOGIN_CAPTCHA_KEY=
# 极验接口异常时：1=拒绝（严格）  留空=放行（fail-open）
GEETEST_FAIL_CLOSED=

# ---------- 会话 ----------
# 闲置超时（小时）：超过该时长未上报心跳即踢出，默认 72（3 天）
SESSION_IDLE_HOURS=72
# 心跳间隔（秒），默认 60
SESSION_HEARTBEAT_SECONDS=60

# ---------- 反向代理（部署在 nginx 之后时必填）----------
TRUST_PROXY=1
TRUST_PROXY_HOPS=1
# 可信反代地址，逗号分隔
TRUSTED_PROXIES=127.0.0.1/32

# ---------- 安全 ----------
# 密码 pepper，留空自动生成并保存到 data/keys/pepper.key
PASSWORD_PEPPER=
# 强制 HTTPS（生产建议 1）
FORCE_HTTPS=1
ENABLE_HSTS=1

# ---------- 邮箱（验证码发信）----------
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
